# EnrollNow Platform - Environment Variables Template
# API Mode: 'mock' for local client-side mock backend, 'real' for live Spring Boot backend
VITE_API_MODE=mock

# The authoritative backend API base URL (used when VITE_API_MODE=real)
VITE_API_BASE_URL=http://localhost:8080

# Optional development error simulation (uncomment to test error scenarios: 401, 403, 500, 503, network)
# VITE_API_MOCK_ERROR=
