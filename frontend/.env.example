# EnrollNow Platform - Environment Variables Template
# Operational API Mode: 'real' for live Spring Boot backend (default), 'mock' for client-side testing
VITE_API_MODE=real

# Authoritative backend API base URL
# Local Development: Use '/api' to route through Vite development proxy (http://localhost:3000/api -> http://localhost:8080/api)
# Production: Use '/api' to route through production reverse proxy (e.g. Nginx, CloudFront)
VITE_API_BASE_URL=/api

# Default Tenant UUID for local verification (fallback when unauthenticated in DEV)
VITE_DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111

# Optional development error simulation (uncomment to test error scenarios: 401, 403, 500, 503, network)
# VITE_API_MOCK_ERROR=
