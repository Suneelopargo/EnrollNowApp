# EnrollNow Platform - Development Environment Configuration Template
# Operational API Mode: 'real' connects to running Spring Boot backend
VITE_API_MODE=real

# Development API Base URL: relative '/api' forwarded by Vite proxy to http://localhost:8080
VITE_API_BASE_URL=/api

# Default Tenant UUID for local development
VITE_DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111

# Optional development error simulation (uncomment to test error scenarios: 401, 403, 500, 503, network)
# VITE_API_MOCK_ERROR=
