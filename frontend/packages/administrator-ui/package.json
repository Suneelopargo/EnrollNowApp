{
  "name": "@aiventrahealth/administrator-ui",
  "version": "1.0.5",
  "description": "Reusable Enterprise Administration UI Library for User, Role, Permission, Location, and Audit Management",
  "type": "module",
  "main": "./dist/administrator-ui.umd.cjs",
  "module": "./dist/administrator-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/administrator-ui.js",
      "require": "./dist/administrator-ui.umd.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
