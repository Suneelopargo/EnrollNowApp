{
  "name": "enrollnow-frontend-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "shared",
    "shell",
    "microfrontends/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=enrollnow-shell",
    "build": "npm run build --workspace=enrollnow-shell",
    "preview": "npm run preview --workspace=enrollnow-shell",
    "start": "npm run preview --workspace=enrollnow-shell",
    "test": "npm run test --workspaces --if-present",
    "test:all": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.5",
    "sass": "^1.105.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
