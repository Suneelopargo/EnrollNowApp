# EnrollNow Platform - Production Environment Configuration Template
VITE_API_MODE=real

# Production API Base URL:
# Recommended: '/api' relative path routed by production reverse proxy (Nginx, AWS ALB, CloudFront) to backend cluster
# Alternatively: full HTTPS origin e.g. 'https://api.enrollnow.example.com/api'
VITE_API_BASE_URL=/api
